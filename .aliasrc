#-------- Set Default Programs {{{
#------------------------------------------------------
# DESC: check and choose the first program in the array that is installed as the default

# find alternative apps if it is installed on your system
find_alt() {
  for cmd in "$@"; do
    if command -v "$cmd" >/dev/null 2>&1; then
      printf '%s\n' "$cmd"
      return 0
    fi
  done
  return 1
}

set_default_app() {
  local name=$1
  local current
  local value
  shift

  eval "current=\${$name:-}"
  if [[ -z "$current" ]]; then
    value=$(find_alt "$@")
    export "$name=$value"
  fi
}

# set the default program
# the first program in the array that is detected on your system will be chosen as the default
set_default_app OPENER xdg-open exo-open gnome-open
set_default_app BROWSER google-chrome-stable google-chrome-unstale chromium chromium-browser firefox "$OPENER"
set_default_app BROWSERCLI w3m links2 links lynx elinks "$OPENER"
set_default_app BROWSERTOR tor-browser-en
set_default_app EBOOKER ebook-viewer "$OPENER"
set_default_app EDITOR nvim vim vi nano "$OPENER"
set_default_app EDITORCLI nvim vim nano pico vi "$OPENER"
set_default_app EDITORGUI code subl mousepad leafpad gedit pluma "$OPENER"
set_default_app FILEMANAGER nemo nautilus thunar dolphin spacefm thunar enlightenment_filemanager "$OPENER"
set_default_app FILEMANAGERCLI ranger vifm mc "$OPENER"
set_default_app PAGER less more most
set_default_app PLAYER mpv mplayer ffplay cvlc "$OPENER"
set_default_app READER mupdf zathura evince "$OPENER"
set_default_app IMAGEVIEWER sxiv feh ristretto display eog "$OPENER"
set_default_app QUEUER tsp fq ts

# }}}

