#
# Language
#

if [[ -z "$LANG" ]]; then
  export LANG='en_US.UTF-8'
fi

#
# Paths
#

# Ensure path arrays do not contain duplicates.
typeset -gU cdpath fpath mailpath path

# Set the list of directories that cd searches.
# cdpath=(
#   $cdpath
# )

# Set the list of directories that Zsh searches for programs.
### path= (
###   $HOME/{,s}bin(N)
###   /opt/{homebrew,local}/{,s}bin(N)
###   /usr/local/{,s}bin(N)
###   $path
### )

path=(
  $HOME/.opencode/bin(N)
  $NPM_GLOBAL/bin(N)
  $PNPM_HOME(N)
  $CARGO_HOME/bin(N)
  $GOPATH/bin(N)
  $GEM_HOME/bin(N)
  $HOME/node_modules/bin(N)
  $HOME/.config/npm(N)
  $HOME/.scripts(N)
  $HOME/.config/rofi/bin(N)
  $HOME/.local/bin/scripts/i3cmds(N)
  $HOME/.local/bin/scripts/cron(N)
  $HOME/.local/bin/scripts/tools(N)
  $HOME/.local/bin/scripts(N)
  $HOME/.local/bin(N)
  $HOME/{bin,sbin}(N)
  /usr/local/{bin,sbin}(N)
  $path
)


#
# Less
#

# Set the default Less options.
# Mouse-wheel scrolling has been disabled by -X (disable screen clearing).
# Remove -X to enable it. 
# Removed from export line this > '-z-4' << this does not work on ver 691
# Removed from if line the -z flag > [[ -z "$LESS" ]] << this does not work on ver 691

if [[ -z "$LESS" ]]; then
  export LESS='-g -i -M -R -S -w -X' 
fi

# Set the Less input preprocessor.
# Try both `lesspipe` and `lesspipe.sh` as either might exist on a system.
if [[ -z "$LESSOPEN" ]] && (( $#commands[(i)lesspipe(|.sh)] )); then
  export LESSOPEN="| /usr/bin/env $commands[(i)lesspipe(|.sh)] %s 2>&-"
fi

#
# Environment Variables
#

# Source environment variables (GitHub MCP PAT, API keys, etc.)
if [[ -f "$XDG_CONFIG_HOME/zsh/.env" ]]; then
  set -a  # automatically export all variables
  source "$XDG_CONFIG_HOME/zsh/.env"
  set +a  # disable auto-export
fi
